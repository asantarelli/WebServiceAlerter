<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WebServiceAlerter.Viewer</RootNamespace>
    <AssemblyName>WebServiceAlerterViewer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <Version>0.3.1</Version>
    <Product>WebServiceAlerter Viewer</Product>
    <Company>SDigitales</Company>

    <!-- ScottPlot.WinForms arrastra OpenTK para un control OpenGL opcional que no usamos; se
         restaura como paquete de .NET Framework y avisa por cada compilación. Silenciar sólo
         ese código evita normalizar el ruido y perder de vista advertencias que sí importan. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.0.47" />
  </ItemGroup>

  <!-- Los iconos van embebidos y no como archivos sueltos: el icono de bandeja es el canal
       principal de aviso, y no puede depender de que una carpeta assets viaje junto al .exe. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\tray-ok.ico" LogicalName="tray-ok.ico" />
    <EmbeddedResource Include="..\..\assets\tray-slow.ico" LogicalName="tray-slow.ico" />
    <EmbeddedResource Include="..\..\assets\tray-down.ico" LogicalName="tray-down.ico" />
    <EmbeddedResource Include="..\..\assets\tray-offline.ico" LogicalName="tray-offline.ico" />
    <EmbeddedResource Include="..\..\assets\icon.ico" LogicalName="icon.ico" />
  </ItemGroup>

</Project>
