{
  // ---------------------------------------------------------------------------------------
  // Configuración de SDigitales. Este archivo SE SOBRESCRIBE en cada actualización.
  // Lo que edita el cliente va en usersettings.json (ver README).
  //
  // Se admiten comentarios: el proveedor de configuración JSON de .NET los ignora.
  // ---------------------------------------------------------------------------------------

  "General": {
    "SiteName": ""
  },

  "Monitoring": {
    "DefaultIntervalSeconds": 30,
    "JitterPercent": 20,

    // Dos, no tres. Medido contra ARCA producción el 2026-08-12: un corte real duró 56 segundos
    // y produjo exactamente 2 chequeos fallidos con este intervalo. Con el valor anterior de 3,
    // ese incidente no se habría detectado — y 56 segundos alcanzan de sobra para que una
    // factura falle y el cliente levante el teléfono.
    "FailuresToAlert": 2,
    "SuccessesToRecover": 2,
    "ReminderIntervalMinutes": 20,
    "DefaultTimeoutMs": 10000,
    "DefaultLatencyWarnMs": 3000,

    "Canary": {
      "Enabled": true,
      "TimeoutMs": 3000,
      "CacheSeconds": 5,
      "Targets": [ "gateway", "8.8.8.8", "https://www.msftconnecttest.com/connecttest.txt" ]
    },

    // Diccionario, no lista: IConfiguration combina objetos por clave, así que una entrada en
    // usersettings.json con el mismo id pisa sólo los campos que declara.
    "Endpoints": {

      // ---- ARCA — producción ---------------------------------------------------------------
      // URLs tomadas de código de facturación en producción (AJEImpositivoAPIClass_AM.clw,
      // método GetUrl), no de documentación: son las que efectivamente se usan hoy.

      // El chequeo que importa. FEDummy no pide autenticación y devuelve el estado de los tres
      // subsistemas por separado, así que detecta el caso que arruina el día: el endpoint
      // contesta 200, el WSDL baja perfecto, y la base de datos está caída.
      "arca-wsfev1": {
        "Name": "ARCA — Facturación Electrónica (WSFEv1)",
        "Group": "ARCA",
        "Enabled": true,
        "Type": "SoapDummy",
        "Url": "https://servicios1.afip.gov.ar/wsfev1/service.asmx",
        "Profile": "arca-wsfev1",
        "LatencyWarnMs": 3000
      },

      // Imprescindible aunque no tenga dummy: sin ticket de acceso no se factura, por más que
      // WSFEv1 esté impecable. Es Axis, así que lo más profundo que se puede chequear sin
      // credenciales es que el WSDL siga sirviéndose.
      "arca-wsaa": {
        "Name": "ARCA — Autenticación (WSAA)",
        "Group": "ARCA",
        "Enabled": true,
        "Type": "Wsdl",
        "Url": "https://wsaa.afip.gov.ar/ws/services/LoginCms",
        "LatencyWarnMs": 3000
      },

      // ---- ARCA — homologación -------------------------------------------------------------
      // Para probar sin tocar producción. Habilitar sólo en equipos de prueba.
      "arca-wsfev1-homo": {
        "Name": "ARCA — WSFEv1 (homologación)",
        "Group": "ARCA homologación",
        "Enabled": false,
        "Type": "SoapDummy",
        "Url": "https://wswhomo.afip.gov.ar/wsfev1/service.asmx",
        "Profile": "arca-wsfev1",
        "IntervalSeconds": 30
      },

      "arca-wsaa-homo": {
        "Name": "ARCA — WSAA (homologación)",
        "Group": "ARCA homologación",
        "Enabled": false,
        "Type": "Wsdl",
        "Url": "https://wsaahomo.afip.gov.ar/ws/services/LoginCms",
        "IntervalSeconds": 60
      },

      // ---- ARCA — servicios accesorios -----------------------------------------------------
      // Deshabilitados a propósito: si el padrón o FECred se caen, se sigue facturando. Sumarlos
      // al semáforo agrega ruido sin responder la pregunta que el usuario tiene. Quedan a un
      // flag de distancia para quien los necesite.
      "arca-padron-a5": {
        "Name": "ARCA — Padrón A5 (consulta de contribuyentes)",
        "Group": "ARCA accesorios",
        "Enabled": false,
        "Type": "Wsdl",
        "Url": "https://aws.afip.gov.ar/sr-padron/webservices/personaServiceA5",
        "IntervalSeconds": 120
      },

      "arca-wsfecred": {
        "Name": "ARCA — Facturas de Crédito Electrónicas",
        "Group": "ARCA accesorios",
        "Enabled": false,
        "Type": "Wsdl",
        "Url": "https://serviciosjava.afip.gob.ar/wsfecred/FECredService",
        "IntervalSeconds": 120
      }
    }
  },

  "Alerting": {
    "Recipients": "",
    "GroupByIncident": true,
    "SuppressWhenOffline": true,
    "MaxMailsPerHour": 12
  },

  // La casilla de envío es fija y NO la edita el cliente.
  // ProtectedPassword se genera en cada equipo con:  WebServiceAlerter.exe --protect-password
  // El blob DPAPI está atado a esa máquina; copiarlo a otra no sirve de nada.
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "ProtectedPassword": "",
    "FromAddress": "",
    "FromDisplayName": "WebServiceAlerter",
    "RetryCount": 3,
    "RetryBackoffSeconds": 5,
    "TimeoutMilliseconds": 15000
  },

  "Http": {
    "IgnoreCertificateErrors": false,
    "UserAgent": "WebServiceAlerter/0.1 (+https://github.com/)",
    "CertificateExpiryWarnDays": 15
  },

  "Database": {
    "Path": "%ProgramData%\\WebServiceAlerter\\webservicealerter.db",
    "RetentionDays": 90
  },

  "StatusFile": {
    "Enabled": true,
    "Path": "%ProgramData%\\WebServiceAlerter\\status.json"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
