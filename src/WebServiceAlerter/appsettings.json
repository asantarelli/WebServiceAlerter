{
  // ---------------------------------------------------------------------------------------
  // Configuración de SDigitales. Este archivo SE SOBRESCRIBE en cada actualización.
  // Lo que edita el cliente va en usersettings.json (ver README).
  //
  // Se admiten comentarios: el proveedor de configuración JSON de .NET los ignora.
  // ---------------------------------------------------------------------------------------

  "General": {
    "SiteName": ""
  },

  "Monitoring": {
    "DefaultIntervalSeconds": 30,
    "JitterPercent": 20,
    "FailuresToAlert": 3,
    "SuccessesToRecover": 2,
    "ReminderIntervalMinutes": 20,
    "DefaultTimeoutMs": 10000,
    "DefaultLatencyWarnMs": 3000,

    "Canary": {
      "Enabled": true,
      "TimeoutMs": 3000,
      "CacheSeconds": 5,
      "Targets": [ "gateway", "8.8.8.8", "https://www.msftconnecttest.com/connecttest.txt" ]
    },

    // Diccionario, no lista: IConfiguration combina objetos por clave, así que una entrada en
    // usersettings.json con el mismo id pisa sólo los campos que declara.
    "Endpoints": {

      // ---- Perfil ARCA -------------------------------------------------------------------
      // PENDIENTE: falta confirmar las URLs vigentes de producción y homologación. Quedan
      // deshabilitadas a propósito: es preferible que el programa no monitoree nada a que
      // monitoree una URL inventada y reporte "caído" para siempre.
      "arca-wsfev1": {
        "Name": "ARCA — Facturación Electrónica (WSFEv1)",
        "Group": "ARCA",
        "Enabled": false,
        "Type": "SoapDummy",
        "Url": "COMPLETAR",
        "Profile": "arca-wsfev1",
        "IntervalSeconds": 30,
        "LatencyWarnMs": 3000
      },

      "arca-wsaa": {
        "Name": "ARCA — Autenticación (WSAA)",
        "Group": "ARCA",
        "Enabled": false,
        "Type": "Wsdl",
        "Url": "COMPLETAR",
        "IntervalSeconds": 60,
        "LatencyWarnMs": 3000
      },

      // ---- Demo --------------------------------------------------------------------------
      // Endpoint de ejemplo para que "--once" muestre algo apenas se clona el repo.
      "demo-http": {
        "Name": "Demo — example.com",
        "Group": "Demo",
        "Enabled": true,
        "Type": "Http",
        "Url": "https://example.com",
        "IntervalSeconds": 30,
        "LatencyWarnMs": 2000
      }
    }
  },

  "Alerting": {
    "Recipients": "",
    "GroupByIncident": true,
    "SuppressWhenOffline": true,
    "MaxMailsPerHour": 12
  },

  // La casilla de envío es fija y NO la edita el cliente.
  // ProtectedPassword se genera en cada equipo con:  WebServiceAlerter.exe --protect-password
  // El blob DPAPI está atado a esa máquina; copiarlo a otra no sirve de nada.
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "ProtectedPassword": "",
    "FromAddress": "",
    "FromDisplayName": "WebServiceAlerter",
    "RetryCount": 3,
    "RetryBackoffSeconds": 5,
    "TimeoutMilliseconds": 15000
  },

  "Http": {
    "IgnoreCertificateErrors": false,
    "UserAgent": "WebServiceAlerter/0.1 (+https://github.com/)",
    "CertificateExpiryWarnDays": 15
  },

  "Database": {
    "Path": "%ProgramData%\\WebServiceAlerter\\webservicealerter.db",
    "RetentionDays": 90
  },

  "StatusFile": {
    "Enabled": true,
    "Path": "%ProgramData%\\WebServiceAlerter\\status.json"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
